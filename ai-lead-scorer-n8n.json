        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-haiku-5-5',\n  max_tokens: 2000,\n  system: 'You are a sales assistant at an AI automation agency. You evaluate contacts submitted through a website form. Reply ONLY with a valid JSON object, no extra text, with these keys: score (integer from 1 to 10, where 10 is a very likely and valuable client), category (\"hot\", \"warm\" or \"cold\"), reason (one short sentence explaining the score), suggested_reply (a short, friendly email in the contact\\'s language, signed as \"The team\"). Criteria: a high budget, a concrete need and urgency raise the score; vague messages, spam or a very low budget lower it.',\n  messages: [{ role: 'user', content: 'Contact details:\\n' + JSON.stringify($json, null, 2) }]\n}) }}",
        "options": {}
      },
      "id": "6f6d36bd-242a-4914-a923-c7bf23c4a5ed",
      "name": "Claude scores the lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        16
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Reads Claude's reply and merges it with the form data\nconst form = $('Contact form').first().json;\n// Claude may return several blocks (e.g. reasoning + text): keep the 'text' ones\nconst blocks = $input.first().json.content ?? [];\nconst text = blocks.filter(b => b.type === 'text').map(b => b.text).join('\\n');\n\nlet ai;\ntry {\n  // In case Claude wraps the JSON in ```\n  ai = JSON.parse(text.replace(/```json|```/g, '').trim());\n} catch (e) {\n  ai = { score: 0, category: 'review', reason: 'The AI did not return valid JSON', suggested_reply: '' };\n}\n\nreturn [{\n  json: {\n    date: new Date().toISOString(),\n    name: form['Name'],\n    email: form['Email'],\n    company: form['Company'] || '',\n    budget: form['Budget'],\n    message: form['Message'],\n    score: Number(ai.score) || 0,\n    category: ai.category,\n    reason: ai.reason,\n    suggested_reply: ai.suggested_reply\n  }\n}];"
      },
